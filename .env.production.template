# Retained ColdForge email-first runtime. Fill privately; never commit real values.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generate independent strong values (for example: openssl rand -hex 32).
# Keep both stable: changing them can make existing encrypted credentials unreadable.
# ENCRYPTION_SECRET also signs unsubscribe tokens. ENCRYPTION_KEY is not read.
ENCRYPTION_SECRET=
ENCRYPTION_SALT=
CRON_SECRET=

# Optional observability; NEXT_PUBLIC_* is public at build time.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_APP_VERSION=
# LOG_LEVEL=info

# Set up Winnr token/SMTP/receiver, organization model policy, and GHL/CloseBot/
# Retell through retained application setup. Provider credentials are encrypted
# in organization-scoped storage, not global fallback environment tokens.
# Retired OAuth/local queue/billing/registrar routes are not configured here.
# Production refuses SMTP_ALLOW_SELF_SIGNED=true and ALLOW_UNVERIFIED_WEBHOOKS=true.
# See docs/ENVIRONMENT.md and docs/OUTREACH-MIGRATION-RUNBOOK.md.
